# PostgreSQL connection string (Neon)
# Get yours from https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/teledhikr?sslmode=require

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Telegram Chat ID (your personal chat or group)
CHAT_ID=your_chat_id_here

# Location for prayer times (latitude/longitude)
LATITUDE=your_latitude_here
LONGITUDE=your_longitude_here

# Local timezone (IANA format)
TIMEZONE=your_timezone_here

# Aladhan prayer time calculation method
# 1=Karachi, 2=ISNA, 3=MWL, 4=Umm al-Qura, 5=Egyptian
PRAYER_METHOD=4
